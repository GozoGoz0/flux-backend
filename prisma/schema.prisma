generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  avatar    String?
  role      UserRole @default(MEMBER)
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)

  createdTasks      Task[]         @relation("TaskCreator")
  assignedTasks     Task[]         @relation("TaskAssignee")
  createdIdeas      Idea[]         @relation("IdeaCreator")
  createdNotes      Note[]
  initiativeOwner   Initiative[]   @relation("InitiativeOwner")
  comments          Comment[]
  approvals         Approval[]
  approvalResponses ApprovalResponse[]
  votes             Vote[]
  activityLogs      ActivityLog[]
  notifications     Notification[]
  refreshTokens     RefreshToken[]

  @@index([email])
  @@index([teamId])
}

model Team {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users        User[]
  invitations  Invitation[]
  initiatives  Initiative[]
  tasks        Task[]
  ideas        Idea[]
  notes        Note[]
  approvals    Approval[]
  activityLogs ActivityLog[]

  @@index([slug])
}

model Invitation {
  id        String           @id @default(cuid())
  code      String           @unique
  email     String?
  role      UserRole         @default(MEMBER)
  expiresAt DateTime
  maxUses   Int              @default(1)
  usedCount Int              @default(0)
  status    InvitationStatus @default(ACTIVE)
  createdAt DateTime         @default(now())

  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([code])
  @@index([teamId])
}

model Initiative {
  id          String           @id @default(cuid())
  title       String
  description String?
  status      InitiativeStatus @default(LATER)
  priority    Priority         @default(MEDIUM)
  startDate   DateTime?
  endDate     DateTime?
  progress    Int              @default(0)
  order       Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  ownerId String?
  owner   User?   @relation("InitiativeOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  tasks        Task[]
  dependencies InitiativeDependency[] @relation("InitiativeFrom")
  dependents   InitiativeDependency[] @relation("InitiativeTo")
  comments     Comment[]
  activityLogs ActivityLog[]

  @@index([teamId])
  @@index([ownerId])
  @@index([status])
}

model InitiativeDependency {
  id        String   @id @default(cuid())
  type      String   @default("blocks")
  createdAt DateTime @default(now())

  fromId String
  from   Initiative @relation("InitiativeFrom", fields: [fromId], references: [id], onDelete: Cascade)

  toId String
  to   Initiative @relation("InitiativeTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId])
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  status      TaskStatus @default(TODO)
  priority    Priority   @default(MEDIUM)
  dueDate     DateTime?
  order       Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  creatorId String
  creator   User   @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Cascade)

  assigneeId String?
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  initiativeId String?
  initiative   Initiative? @relation(fields: [initiativeId], references: [id], onDelete: SetNull)

  checklistItems ChecklistItem[]
  comments       Comment[]
  attachments    Attachment[]
  activityLogs   ActivityLog[]

  @@index([teamId])
  @@index([creatorId])
  @@index([assigneeId])
  @@index([initiativeId])
  @@index([status])
}

model ChecklistItem {
  id        String   @id @default(cuid())
  text      String
  completed Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model Idea {
  id          String     @id @default(cuid())
  title       String
  description String?
  status      IdeaStatus @default(NEW)
  voteCount   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  creatorId String
  creator   User   @relation("IdeaCreator", fields: [creatorId], references: [id], onDelete: Cascade)

  votes        Vote[]
  comments     Comment[]
  activityLogs ActivityLog[]

  @@index([teamId])
  @@index([creatorId])
  @@index([status])
}

model Vote {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  ideaId String
  idea   Idea   @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([ideaId, userId])
  @@index([ideaId])
  @@index([userId])
}

model Note {
  id        String   @id @default(cuid())
  title     String
  content   String
  isPrivate Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  attachments  Attachment[]
  activityLogs ActivityLog[]

  @@index([teamId])
  @@index([authorId])
  @@index([isPrivate])
}

model Approval {
  id          String         @id @default(cuid())
  title       String
  description String?
  status      ApprovalStatus @default(PENDING)
  version     String?
  dueDate     DateTime?
  requireAll  Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  requesterId String
  requester   User   @relation(fields: [requesterId], references: [id], onDelete: Cascade)

  responses    ApprovalResponse[]
  attachments  Attachment[]
  comments     Comment[]
  activityLogs ActivityLog[]

  @@index([teamId])
  @@index([requesterId])
  @@index([status])
}

model ApprovalResponse {
  id        String               @id @default(cuid())
  decision  ApprovalDecision
  comment   String?
  createdAt DateTime             @default(now())

  approvalId String
  approval   Approval @relation(fields: [approvalId], references: [id], onDelete: Cascade)

  approverId String
  approver   User   @relation(fields: [approverId], references: [id], onDelete: Cascade)

  @@unique([approvalId, approverId])
  @@index([approvalId])
  @@index([approverId])
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  initiativeId String?
  initiative   Initiative? @relation(fields: [initiativeId], references: [id], onDelete: Cascade)

  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  ideaId String?
  idea   Idea?   @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  approvalId String?
  approval   Approval? @relation(fields: [approvalId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([initiativeId])
  @@index([taskId])
  @@index([ideaId])
  @@index([approvalId])
}

model Attachment {
  id        String   @id @default(cuid())
  filename  String
  url       String
  size      Int
  mimeType  String
  createdAt DateTime @default(now())

  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  noteId String?
  note   Note?   @relation(fields: [noteId], references: [id], onDelete: Cascade)

  approvalId String?
  approval   Approval? @relation(fields: [approvalId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([noteId])
  @@index([approvalId])
}

model Notification {
  id        String   @id @default(cuid())
  type      String
  title     String
  content   String?
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
}

model ActivityLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String
  metadata  String?
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  initiativeId String?
  initiative   Initiative? @relation(fields: [initiativeId], references: [id], onDelete: Cascade)

  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  ideaId String?
  idea   Idea?   @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  noteId String?
  note   Note?   @relation(fields: [noteId], references: [id], onDelete: Cascade)

  approvalId String?
  approval   Approval? @relation(fields: [approvalId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([teamId])
  @@index([entity, entityId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

enum UserRole {
  OWNER
  ADMIN
  MEMBER
  OBSERVER
}

enum InvitationStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum InitiativeStatus {
  NOW
  NEXT
  LATER
  DONE
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  BLOCKED
  DONE
  CANCELLED
}

enum IdeaStatus {
  NEW
  DISCUSSING
  ACCEPTED
  POSTPONED
  REJECTED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
  REJECTED
}

enum ApprovalDecision {
  APPROVE
  REQUEST_CHANGES
  REJECT
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}
